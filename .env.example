# Copy to .env and fill in real values before running the app.

# The live site URL — used by the sitemap, robots.txt, and Open Graph tags.
# No trailing slash.
NEXT_PUBLIC_SITE_URL="https://agrolinksourcing.com"

# Postgres connection string (Supabase / Neon / Railway / local Docker)
DATABASE_URL="postgresql://user:password@localhost:5432/agrolink"

# WhatsApp business number in E.164 without "+" (e.g. 233201234567)
NEXT_PUBLIC_WHATSAPP_NUMBER="233544200542"
# Public contact details (footer + /contact)
NEXT_PUBLIC_CONTACT_EMAIL="hello@agrolinksourcing.com"
NEXT_PUBLIC_CONTACT_LOCATION="Accra, Ghana"
# Set to "false" once real products replace the seeded demo data (hides the footer demo notice)
NEXT_PUBLIC_SHOW_DEMO_NOTICE="true"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public sign-in (buyer/supplier/farmer/student) — passwordless magic-link
# email sent via Brevo's HTTP API. NOT SMTP (Gmail SMTP was tried first —
# serverless platforms like Vercel block/drop outbound SMTP connections,
# which made sign-in hang forever with no error). Brevo needs no domain
# either — it verifies a single email address you already own, not a
# domain, unlike Resend/SendGrid/Mailgun's domain-based verification.
#
# Setup (no domain required):
#   1. Sign up free at brevo.com
#   2. Settings (gear icon) -> Senders, Domains & Dedicated IPs -> Senders
#      -> Add a Sender -> enter the email you want to send from -> click
#      the confirmation link Brevo emails to that address
#   3. Settings -> SMTP & API -> API Keys -> Generate a new API key
#   4. Paste the key and the verified sender address below
# Preferred (domain verified): Resend
RESEND_API_KEY=""
# Fallback: Brevo
BREVO_API_KEY=""
EMAIL_FROM="hello@agrolinksourcing.com"
EMAIL_FROM_NAME="AgroLink"
# Without BREVO_API_KEY/EMAIL_FROM set, sign-in links are logged to the
# server console in development instead of emailed — see src/lib/mail.ts.

# Image storage (choose one, fill in when ready)
CLOUDINARY_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudinary unsigned uploads — used by every upload zone (Add Product,
# List Your Product, Post Update). Both values are safe to expose to the
# browser (NEXT_PUBLIC_) because the upload preset is unsigned and scoped.
# Set up: Cloudinary dashboard → Settings → Upload → Add upload preset →
# Signing Mode: Unsigned. Without these set, every upload zone shows a
# clear "not configured yet" message instead of pretending to work.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Cloudinary signed API access — server-only, NEVER prefix with NEXT_PUBLIC_.
# Only used to delete an asset when someone removes a file from an
# in-progress form before submitting (see src/lib/cloudinary-admin.ts).
# Find both under Cloudinary dashboard → Settings → Access Keys.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
